WITH accounts_email AS (
#Taking necessary account data
  SELECT
    sp.country,
    ac.send_interval,
    ac.is_verified,
    ac.is_unsubscribed,
    COUNT(DISTINCT ac.id) AS account_cnt,
    MIN(se.date) AS date,
    0 AS sent_msg,
    0 AS open_msg,
    0 AS visit_msg
  FROM data-analytics-mate.DA.account ac
  JOIN data-analytics-mate.DA.account_session acs
    ON ac.id = acs.account_id
  JOIN data-analytics-mate.DA.session_params sp
    ON acs.ga_session_id = sp.ga_session_id
  JOIN data-analytics-mate.DA.session se
    ON acs.ga_session_id = se.ga_session_id
GROUP BY 1, 2, 3, 4


UNION ALL


#Taking necessary email data plus adding account data for UNION
SELECT
  sp.country,
  ac.send_interval,
  ac.is_verified,
  ac.is_unsubscribed,
  0 AS account_cnt,
  se.date,
  COUNT(DISTINCT es.id_message) AS sent_msg,
  COUNT(DISTINCT eo.id_message) AS open_msg,
  COUNT(DISTINCT ev.id_message) AS visit_msg
FROM data-analytics-mate.DA.email_sent es
LEFT JOIN data-analytics-mate.DA.email_open eo
  ON es.id_message = eo.id_message
LEFT JOIN data-analytics-mate.DA.email_visit ev
  ON es.id_message = ev.id_message
JOIN data-analytics-mate.DA.account ac
  ON es.id_account = ac.id
JOIN data-analytics-mate.DA.account_session acs
  ON ac.id = acs.account_id
JOIN data-analytics-mate.DA.session se
  ON acs.ga_session_id = se.ga_session_id
JOIN data-analytics-mate.DA.session_params sp
  ON acs.ga_session_id = sp.ga_session_id
GROUP BY 1, 2, 3, 4, 6
),


aggregations AS(
#Aggregating the received data from both queries
  SELECT
    country,
    send_interval,
    is_verified,
    is_unsubscribed,
    date,
    SUM(account_cnt) AS account_cnt,
    SUM(sent_msg) AS sent_msg,
    SUM(open_msg) AS open_msg,
    SUM(visit_msg) AS visit_msg
  FROM accounts_email
  GROUP BY 1, 2, 3, 4, 5
),


totals AS (
#Counting accounts and emails per country before ranking
  SELECT
    *,
    SUM(account_cnt) OVER (PARTITION BY country) AS total_country_account_cnt,
    SUM(sent_msg) OVER (PARTITION BY country) AS total_country_sent_cnt
  FROM aggregations ag
),


ranks AS (
#ranking countries by accounts and emails
SELECT
  *,
  DENSE_RANK() OVER (ORDER BY total_country_account_cnt DESC) AS rank_total_country_account_cnt,
  DENSE_RANK() OVER (ORDER BY total_country_sent_cnt DESC) AS rank_total_country_sent_cnt
FROM totals
)


#Finalizing, filtering by rank
SELECT
  *
FROM ranks
WHERE rank_total_country_account_cnt <= 10 OR rank_total_country_sent_cnt <= 10
